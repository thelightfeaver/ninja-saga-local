# Normalise line endings.  Batch/PowerShell get CRLF on checkout; the
# macOS launchers and shell/PHP/Python sources must stay LF.
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.command text eol=lf
*.sh text eol=lf
*.php text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.swf binary
*.wasm binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary
*.zip binary
*.pem binary
